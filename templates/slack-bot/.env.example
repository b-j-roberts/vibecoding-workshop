# Slack Bot Tokens
# Get these from https://api.slack.com/apps → your app's settings
#
# Bot Token: OAuth & Permissions → Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
#
# App Token: Basic Information → App-Level Tokens → Generate Token
# Required scopes: connections:write
SLACK_APP_TOKEN=xapp-your-app-token
#
# Signing Secret: Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret
